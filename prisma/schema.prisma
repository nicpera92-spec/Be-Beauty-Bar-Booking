generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id            String     @id @default(cuid())
  technicianId  String
  technician    Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  name          String
  category      String     // nails | lash | permanent-makeup | custom slug
  position      Int        @default(0)
  durationMin   Int
  price         Float      @default(0)
  depositAmount Float
  depositPercent Float?    // set = deposit is this % of price (depositAmount kept in sync); null = fixed £ amount
  requiresDeposit Boolean  @default(true) // when false, bookings confirm without a deposit payment
  description   String?    @default("")
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  addOns        AddOn[]
  bookings      Booking[]
  waitingListEntries WaitingListEntry[]
  giftCertificateItems GiftCertificateItem[]
}

model AddOn {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Technician {
  id           String    @id @default(cuid())
  name         String
  bio          String?   @default("")
  skillLevel   String?   @default("")
  instagramHandle String?
  role         String    @default("technician") // master | technician
  loginEmail   String?   @unique
  passwordHash String?
  position     Int       @default(0)
  active       Boolean   @default(true)
  categoryOrder String?  // JSON array of category slugs controlling booking-page order
  // Weekly schedule JSON: 7 DaySchedule (index = JS getDay, Sun=0). null = salon open/close every day.
  workingHours Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  services     Service[]
  bookings     Booking[]
  availabilityBlocks AvailabilityBlock[]
  waitingListEntries WaitingListEntry[]
}

model CategoryCapacityRule {
  id            String   @id @default(cuid())
  category      String   @unique // e.g. nails, lash, permanent-makeup
  maxConcurrent Int      @default(1) // max overlapping bookings in this category at once
  updatedAt     DateTime @updatedAt
}

// Two categories that must not overlap in time (salon-wide). Stored with categoryA <= categoryB.
model CategoryExclusionRule {
  id        String   @id @default(cuid())
  categoryA String
  categoryB String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryA, categoryB])
}

model BusinessSettings {
  id                   String   @id // single row, use "default"
  businessName         String   @default("Be Beauty Bar")
  businessEmail        String?
  businessAddress      String?
  adminLoginEmail      String?
  adminPasswordHash    String?
  instagramHandle      String?
  defaultDepositAmount Float?
  defaultPrice         Float?
  openTime             String   @default("09:00")
  closeTime            String   @default("17:00")
  slotInterval         Int      @default(30)
  primaryColor         String?  @default("#1e3a5f")
  secondaryColor       String?  @default("#2c5282")
  stripeSecretKey      String?
  stripeWebhookSecret  String?
  smsNotificationFee   Float?   @default(0.05)
  waitlistEnabled      Boolean  @default(true)
  rebookReminderEnabled   Boolean  @default(false)
  rebookReminderDaysAfter Int      @default(21)
  cancellationRefundHours Int      @default(48) // deposit refunded when customer cancels at least this many hours before
  cancellationPolicy   String? // one point per line; null = default policy
  reviewRequestEnabled Boolean  @default(false)
  googleReviewUrl      String?
  dailyScheduleEnabled Boolean  @default(true)
  dailyScheduleLastSentDate String? // UK date the 7pm schedule emails were last sent (yyyy-MM-dd)
  notificationMessages Json?
  updatedAt            DateTime @updatedAt
}

model WaitingListEntry {
  id                String     @id @default(cuid())
  serviceId         String
  service           Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  technicianId      String
  technician        Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  customerName      String
  customerEmail     String?
  customerPhone     String?
  notifyByEmail     Boolean    @default(true)
  notifyBySMS       Boolean    @default(false)
  preferredDate     String
  preferredDateEnd  String?
  notifyEarliest    Boolean    @default(false)
  status            String     @default("active")
  lastNotifiedAt    DateTime?
  notifiedSlotDate  String?
  notifiedSlotTime  String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([serviceId, technicianId, preferredDate, status])
  @@index([preferredDate, status])
}

model CustomerNotificationPreference {
  id                   String    @id @default(cuid())
  email                String?   @unique
  phone                String?   @unique
  rebookReminderOptOut Boolean   @default(false)
  rebookOptOutAt       DateTime?
  reviewedAt           DateTime? // set = never send a Google review request again
  reviewSource         String?   // link (tapped the review link) | owner (marked in admin)
  updatedAt            DateTime  @updatedAt
}

model GiftVoucher {
  id                    String              @id @default(cuid())
  code                  String              @unique
  kind                  String              @default("credit") // credit (old £ vouchers) | certificate (treatments paid in full)
  packageName           String?             // set when bought as one of the salon's combo packages
  initialAmount         Float               // amount paid
  balance               Float               // credit vouchers only; certificates stay 0
  status                String              @default("pending_payment") // pending_payment | active | cancelled
  purchaserName         String
  purchaserEmail        String
  recipientName         String?
  recipientEmail        String?
  message               String?
  soldInSalon           Boolean             @default(false)
  stripeSessionId       String?             @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  expiresAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bookings              Booking[]
  transactions          VoucherTransaction[]
  items                 GiftCertificateItem[]
}

// One treatment on a gift certificate (a combo certificate has several), paid in full when bought.
model GiftCertificateItem {
  id             String      @id @default(cuid())
  voucherId      String
  voucher        GiftVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName    String
  technicianName String?
  price          Float       // treatment price when the certificate was bought
  position       Int         @default(0)
  status         String      @default("available") // available | booked | used
  bookingId      String?     // booking currently using this treatment
  usedAt         DateTime?
  createdAt      DateTime    @default(now())
  bookings       Booking[]

  @@index([voucherId])
}

// A combo the owner sells as one gift certificate, at its own price.
model GiftPackage {
  id          String   @id @default(cuid())
  name        String
  description String?  @default("")
  price       Float
  serviceIds  String[]
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Ledger of voucher balance changes: negative = value used, positive = value returned
model VoucherTransaction {
  id        String      @id @default(cuid())
  voucherId String
  voucher   GiftVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  amount    Float
  note      String
  bookingId String?
  createdAt DateTime    @default(now())

  @@index([voucherId, createdAt])
}

// One-time codes for the customer "My bookings" page (contact = lowercased email or +44 phone)
model CustomerLoginCode {
  id        String    @id @default(cuid())
  contact   String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([contact, createdAt])
}

model AvailabilityBlock {
  id           String      @id @default(cuid())
  technicianId String? // null = salon-wide (master); set = that technician's own time off
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  startDate    String
  startTime    String
  endDate      String
  endTime      String
  createdAt    DateTime    @default(now())
}

model BookingAddOn {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId    String
  addOnName  String
  addOnPrice Float
}

model Booking {
  id                            String         @id @default(cuid())
  serviceId                     String
  service                       Service        @relation(fields: [serviceId], references: [id])
  technicianId                  String
  technician                    Technician     @relation(fields: [technicianId], references: [id])
  bookingAddOns                 BookingAddOn[]
  customerName                  String
  customerEmail                 String?
  customerPhone                 String?
  date                          String
  startTime                     String
  endTime                       String
  servicePrice                  Float
  depositAmount                 Float
  balancePaidOnline             Boolean        @default(false)
  status                        String         @default("pending_deposit")
  notes                         String?        @default("")
  notifyByEmail                 Boolean        @default(true)
  notifyBySMS                   Boolean        @default(false)
  stripeDepositPaymentIntentId  String?
  stripeBalancePaymentIntentId  String?
  depositRefundedAt             DateTime?
  balanceRefundedAt             DateTime?
  customerCancelledAt           DateTime? // set when the customer cancels via their confirmation link
  cancelCode                    String?        @unique // short code for the SMS cancel link (/c/<code>)
  rescheduleCount               Int            @default(0) // times the customer moved this booking via their link
  rescheduledAt                 DateTime?
  reviewRequestSentAt           DateTime?
  voucherId                     String?
  voucher                       GiftVoucher?   @relation(fields: [voucherId], references: [id])
  voucherAmount                 Float          @default(0) // part of depositAmount paid by gift voucher
  voucherRestoredAt             DateTime?      // voucher part returned to the voucher (refund / expiry)
  certificateItemId             String?        // set = treatment paid in full by a gift certificate
  certificateItem               GiftCertificateItem? @relation(fields: [certificateItemId], references: [id], onDelete: SetNull)
  reminderSentAt                DateTime?
  rebookReminderSentAt          DateTime?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
}
